# Copy to server/.env and fill in.

# MongoDB Atlas connection string (free M0 cluster is enough).
# Leave empty to run with an in-memory store (data resets on restart).
MONGODB_URI=

# Secret for reading contact messages: GET /api/admin/messages
# with header "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=change-me-to-a-long-random-string

PORT=5000

# Only needed if the client is hosted on a different domain (e.g. Vercel),
# comma-separated: https://arpit.vercel.app,https://www.yourdomain.com
CLIENT_ORIGIN=
